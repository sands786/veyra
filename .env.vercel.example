# Optional public Vite build-time overrides. The Vercel frontend can load the
# public OAuth launch values through the same-origin managed-backend rewrite,
# so these are not required for Sign In when using the documented Vercel setup.
# Never place JWT_SECRET, DATABASE_URL, BUILT_IN_FORGE_API_KEY, or any wallet material in Vercel.

# Optional Manus application identity overrides. If set, define both values.
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=

# Optional client presentation values.
VITE_APP_TITLE=Veyra — Private Financial Coordination on Starknet
VITE_APP_LOGO=
