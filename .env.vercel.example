# Optional public Vite presentation overrides. Veyra-owned account registration
# and sign-in use the same-origin managed-backend rewrite and need no Vercel
# authentication variables or external callback configuration.
# Never place JWT_SECRET, DATABASE_URL, BUILT_IN_FORGE_API_KEY, or any wallet material in Vercel.

# Optional client presentation values.
VITE_APP_TITLE=Veyra — Private Financial Coordination on Starknet
VITE_APP_LOGO=

# Required before real Mainnet STRK20 execution. This is a public contract
# address, not a secret. Do not invent or use a testnet address.
VITE_VEYRA_STRK20_PRIVACY_CONTRACT_MAINNET=

# Official STRK20 SDK runtime values. Populate only from a matching, verified
# Mainnet deployment and release; empty values keep execution fail-closed.
VITE_VEYRA_STRK20_SDK_VERSION=
VITE_VEYRA_STRK20_RPC_URL=
VITE_VEYRA_STRK20_INDEXER_URL=
VITE_VEYRA_STRK20_PROVING_SERVICE_URL=
VITE_VEYRA_STRK20_DISCOVERY_SERVICE_URL=
VITE_VEYRA_STRK20_POOL_CLASS_HASH=
VITE_VEYRA_STRK20_COMPLIANCE_PUBLIC_KEY=
