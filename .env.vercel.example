# Public Vite build-time settings. Copy these into Vercel Project Settings → Environment Variables.
# Never place JWT_SECRET, DATABASE_URL, BUILT_IN_FORGE_API_KEY, or any wallet material in Vercel.

# Manus application identity used by the browser to start OAuth.
VITE_APP_ID=replace-with-your-manus-app-id
VITE_OAUTH_PORTAL_URL=https://oauth.manus.im

# Optional client presentation values.
VITE_APP_TITLE=Veyra — Private Financial Coordination on Starknet
VITE_APP_LOGO=
